# Example environment file for the Fineract Rust Docker Compose test environment.
#
# Copy to .env and adjust values as needed:
#   cp .env.example .env
#

# PostgreSQL
FINERACT_DB_PASSWORD=postgres
FINERACT_DB_PORT=5432

# Provider
FINERACT_PROVIDER_PORT=8080
FINERACT_PLATFORM_TENANT_IDENTIFIER=desarrollo

# Full database URL (overrides individual parts if set)
# Format: postgresql://<user>:<password>@postgres:5432/<database>
FINERACT_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/fineract_desarrollo

# Logging
RUST_LOG=fineract_provider=debug,tower_http=debug
